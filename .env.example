# Copy to .env next to docker-compose.yml.
# The Kindle's quad.conf TOKEN must match QUAD_TOKEN.
QUAD_TOKEN=troque-este-token
# Opens the dashboard: http://<casaos>:8740/?k=<QUAD_ADMIN>
QUAD_ADMIN=troque-este-tambem
# Optional: Claude's one-line brief at the top of the board. Run `claude setup-token`
# on a computer with a browser (Claude Code installed) and paste the token here.
CLAUDE_CODE_OAUTH_TOKEN=
